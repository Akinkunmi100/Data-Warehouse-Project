[Unit]
Description=Research Platform Prefect QC Worker
After=rp-webhook.service rp-etl-worker.service

[Service]
Type=simple
User=platform
WorkingDirectory=/mnt/c/Users/msi/Documents/Data Warehouse Project/research-platform
# FIX: same as rp-etl-worker — user-local python3 so user site-packages are found.
ExecStart=/home/platform/.local/bin/python3 etl/qc/qc_engine.py
Environment=PYTHONPATH=/home/platform/.local/lib/python3.12/site-packages
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
