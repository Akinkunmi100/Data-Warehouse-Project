[Unit]
Description=Research Platform Prefect QC Worker
After=rp-webhook.service rp-etl-worker.service

[Service]
Type=simple
User=platform
WorkingDirectory=/mnt/c/Users/msi/Documents/Data Warehouse Project/research-platform
ExecStart=/usr/bin/python3 etl/qc/qc_engine.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
