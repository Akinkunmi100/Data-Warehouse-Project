[Unit]
Description=Research Platform Webhook Gateway

[Service]
Type=simple
User=platform
WorkingDirectory=/mnt/c/Users/msi/Documents/Data Warehouse Project/research-platform
ExecStart=/usr/bin/python3 -m uvicorn webhook.webhook_server:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
