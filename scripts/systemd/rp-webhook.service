[Unit]
Description=Research Platform Webhook Gateway

[Service]
Type=simple
User=platform
WorkingDirectory=/mnt/c/Users/msi/Documents/Data Warehouse Project/research-platform
# FIX: use user-local python3 / uvicorn so all pip-installed packages are found.
ExecStart=/home/platform/.local/bin/uvicorn webhook.webhook_server:app --host 0.0.0.0 --port 8001
Environment=PYTHONPATH=/home/platform/.local/lib/python3.12/site-packages
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
